# ==========================================
# URL Shortener - Docker Environment
# Copy this to .env.local and customize for production!
# ==========================================

# 🔐 Database Authentication (CHANGE THESE FOR SECURITY!)
DB_USER=urlshortener
DB_PASSWORD=mysecretpassword123

# 🌐 Server Configuration  
HOST=0.0.0.0
APP_PORT=8000

# 🔌 Database Connection Settings (used by docker-compose override)
DB_PORT=5432  # Default PostgreSQL port (5432) - leave default unless changed

# 📝 Note: The .dockerignore prevents secrets from being in the image
# The web service uses 'database' hostname internally via Docker network
