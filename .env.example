# ==========================================
# URL Shortener Environment Configuration
# Copy this to .env and customize as needed
# ==========================================

# 🔐 Database Authentication (CHANGE THESE!)
DB_USER=your_database_username_here
DB_PASSWORD=your_secure_password_here!@#$%
POSTGRES_DB=urlshortener

# 🌐 Server Configuration
HOST=0.0.0.0         # Bind address (0.0.0.0 for all interfaces)
APP_PORT=8000        # API server port

# 🔌 Database Connection String (auto-generated for convenience)
# This will be used by docker-compose override
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@database:5432/urlshortener

# 🌍 CORS Configuration (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://your-domain.com

# 🐳 Docker Override Settings
DB_PORT=5432         # Exposed PostgreSQL port in docker-compose override
