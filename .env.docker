# ==========================================
# URL Shortener - Docker Environment Template (DEV)
# Use for development with local volume mounts
# ==========================================

# 🔐 Database Credentials 
DB_USER=urlshortener
DB_PASSWORD=mysecretpassword123

# 🌐 Server Configuration
APP_PORT=8000                        # API will be on port 8000

# 📊 Debug Settings
DEBUG=true                          # Set to true for development logs

# 🚀 Application settings
UVICORN_LOG_LEVEL=debug             # DEBUG, INFO, WARNING, ERROR

# ==========================================
# 💡 IMPORTANT: 
# For production/custom passwords with special chars (!@#$),
# use docker-compose.override.yml instead of modifying .env.docker
# Copy it to .env.local.prod and set your secrets there
# ==========================================
# 
